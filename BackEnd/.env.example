# PostgreSQL connection string (e.g. Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Long random string used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login stays valid
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=https://fcms-b958.vercel.app,http://localhost:8080
